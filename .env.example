# =============================================================================
# Market Sense — Environment variables
# Copy this file to .env and fill in the values for your deployment.
# =============================================================================

# ---------- Logged-in user (single-tenant UAT) ----------
# The dashboard is scoped to one user. Default = 9 (Kedar Lele).
# Change this to demo as a different user from
# tbl_market_visit_feedback_users.csv
CURRENT_USER_ID=9

# ---------- AI / LLM (optional) ----------
# The dashboard works without these; the server-side Verbatim AI summary
# silently falls back to the client-side lexicon summary if no provider
# credentials are set.
#
# Option A — OpenCode Zen (preferred):
opencode_api_key=

# Option B — Ollama (local or hosted) — used only if opencode_api_key is empty:
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_KEY=
# For cloud/remote Ollama, set OLLAMA_HOST=https://your-ollama-server.com
